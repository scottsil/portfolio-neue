---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Projects · Your Name Here"
  description="Placeholder projects page description — replace this before publishing."
>
  <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
  <p class="mt-3 max-w-prose text-zinc-600 dark:text-zinc-400">
    Placeholder projects intro — replace this before publishing.
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      projects.map((project) => (
        <li>
          <a
            href={`/projects/${project.id}`}
            class="block h-full rounded-lg border border-zinc-200 p-5 hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-500"
          >
            <h2 class="font-semibold tracking-tight">{project.data.title}</h2>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
              {project.data.description}
            </p>
            {project.data.tags && project.data.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <li class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
